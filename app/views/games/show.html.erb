<h1><%= @game.name %></h1>

<div class="game-info">
  <p><strong>Generation:</strong>
    <span id="generation_count" data-generation="<%= @game.current_generation %>"><%= @game.current_generation %></span>
  </p>
  <p><strong>Size:</strong> <%= @game.rows %> rows x <%= @game.columns %> columns</p>
</div>

<div class="game-grid-container" id="game_grid">
  <%= render "grid", grid: @game.current_grid %>
</div>

<div class="game-controls" data-controller="simulation"
     data-simulation-next-url-value="<%= next_generation_game_path(@game) %>"
     data-simulation-reset-url-value="<%= reset_game_path(@game) %>"
     data-simulation-max-generation-value="1000">
  <div class="control-group">
    <button type="button" class="control-btn" title="Play" data-action="click->simulation#play" data-simulation-target="playBtn">&#9654;</button>
    <button type="button" class="control-btn" title="Pause" data-action="click->simulation#pause" data-simulation-target="pauseBtn" disabled>&#10074;&#10074;</button>
    <button type="button" class="control-btn" title="Next" data-action="click->simulation#next" data-simulation-target="nextBtn">&#9654;&#10074;</button>
  </div>
  <div class="control-group">
    <button type="button" class="control-btn" title="Reset" data-action="click->simulation#reset" data-simulation-target="resetBtn">&#8635;</button>
  </div>
</div>

<p><%= link_to "Back to games", games_path %></p>
