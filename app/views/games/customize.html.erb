<h1>Customize game</h1>

<div class="game-info">
  <p><strong>Name:</strong> <%= @draft["name"] %></p>
  <p><strong>Generation:</strong> <%= @draft["generation"] %></p>
  <p><strong>Size:</strong> <%= @draft["rows"] %> rows x <%= @draft["columns"] %> columns</p>
</div>

<p>Click on cells to toggle them</p>

<%= form_with url: games_path, method: :post, scope: :create, data: { controller: "grid-editor", action: "submit->grid-editor#submitForm" } do |form| %>
  <%= form.hidden_field :grid, value: @draft["grid"].to_json, data: { grid_editor_target: "gridInput" } %>

  <div class="game-grid-container">
    <table class="game-grid game-grid--editable" data-grid-editor-target="grid">
      <% @draft["grid"].each_with_index do |row, row_index| %>
        <tr>
          <% row.each_with_index do |cell, col_index| %>
            <td class="<%= cell ? 'alive' : 'dead' %>"
                data-action="click->grid-editor#toggleCell"
                data-row="<%= row_index %>"
                data-col="<%= col_index %>">
            </td>
          <% end %>
        </tr>
      <% end %>
    </table>
  </div>

  <div>
    <%= form.submit "Create game", class: "btn" %>
    <%= link_to "Back", new_game_path, class: "btn btn-secondary" %>
  </div>
<% end %>
