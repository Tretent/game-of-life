<h1><%= t(".title") %></h1>

<%= form_with url: customize_games_path,
              method: :post,
              scope: :customize,
              data: { controller: "pattern-form" } do |form| %>
  <div>
    <%= form.label :name %>
    <%= form.text_field :name,
                        value: params.dig(:customize, :name),
                        required: true,
                        placeholder: t(".name_placeholder"),
                        data: { pattern_form_target: "name", action: "input->pattern-form#updateSubmitState" } %>
  </div>

  <div>
    <%= form.label :initial_state, t(".pattern_file") %>
    <%= form.file_field :initial_state,
                        accept: "text/plain",
                        required: true,
                        data: { pattern_form_target: "file", action: "change->pattern-form#validateFile" } %>
    <p class="error" style="display: none;" data-pattern-form-target="fileError"></p>
    <% if @error.present? %>
      <p class="error"><%= @error %></p>
    <% end %>
  </div>

  <div class="form-actions">
    <%= form.submit t(".next"), class: "btn", data: { pattern_form_target: "submit" }, disabled: true %>
    <%= link_to t(".cancel"), games_path, class: "btn btn-secondary" %>
    <button type="button" class="btn" data-action="pattern-form#loadExample"><%= t(".load_example") %></button>
  </div>
<% end %>

<hr>

<h3><%= t(".file_format") %></h3>
<ul>
  <li><%= t(".instructions.generation") %></li>
  <li><%= t(".instructions.rows") %></li>
  <li><%= t(".instructions.columns") %></li>
  <li><%= t(".instructions.cells", alive: "<code>*</code>", dead: "<code>.</code>").html_safe %></li>
</ul>

<h3><%= t(".example") %></h3>
<pre>
Generation 1:
4 8
........
....*...
*****...
........
</pre>
