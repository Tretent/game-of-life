<h1>My games</h1>

<p><%= link_to "New game", new_game_path, class: "btn" %></p>

<% if @games.any? %>
  <div class="game-list">
    <% @games.each do |game| %>
      <div class="game-card">
        <h2><%= link_to game.name, game_path(game) %></h2>
        <div class="game-card-actions">
          <%= button_to "Play", game_path(game), class: "btn" %>
          <%= button_to "Delete", game_path(game), method: :delete, class: "btn btn-danger", data: { turbo_confirm: "Are you sure? This cannot be undone." } %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <p>No games yet. Create your first one!</p>
<% end %>
