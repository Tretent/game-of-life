<h1><%= t(".title") %></h1>

<div class="index-actions" data-controller="modal">
  <%= link_to t(".new_game"), new_game_path, class: "btn" %>
  <%= link_to t(".about"), "#", data: { action: "click->modal#open" } %>

  <dialog class="rules-modal" data-modal-target="dialog" data-action="click->modal#clickOutside">
    <div class="rules-modal-content">
      <h2><%= t(".rules.title") %></h2>
      <p><%= t(".rules.intro") %></p>
      <ol>
        <li><%= t(".rules.underpopulation") %></li>
        <li><%= t(".rules.survival") %></li>
        <li><%= t(".rules.overpopulation") %></li>
        <li><%= t(".rules.reproduction") %></li>
      </ol>
    </div>
  </dialog>
</div>

<% if @games.any? %>
  <div class="game-list">
    <% @games.each do |game| %>
      <div class="game-card">
        <h2><%= link_to game.name, game_path(game) %></h2>
        <div class="game-card-actions">
          <%= link_to t(".play"), game_path(game), class: "btn" %>
          <%= button_to t(".delete"), game_path(game), method: :delete, class: "btn btn-danger", data: { turbo_confirm: t(".confirm_delete") } %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <p><%= t(".no_games") %></p>
<% end %>
