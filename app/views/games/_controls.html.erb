<div class="game-controls" data-controller="simulation"
     data-simulation-next-url-value="<%= next_generation_game_path(game) %>"
     data-simulation-reset-url-value="<%= reset_game_path(game) %>"
     data-simulation-max-generation-value="1000">
  <div class="control-group">
    <button type="button" class="control-btn" title="Play"
            data-action="click->simulation#play"
            data-simulation-target="playBtn">&#9654;</button>
    <button type="button" class="control-btn" title="Pause"
            data-action="click->simulation#pause"
            data-simulation-target="pauseBtn" disabled>&#10074;&#10074;</button>
    <button type="button" class="control-btn" title="Next"
            data-action="click->simulation#next"
            data-simulation-target="nextBtn">&#9654;&#10074;</button>
  </div>
  <div class="control-group">
    <button type="button" class="control-btn" title="Reset"
            data-action="click->simulation#reset"
            data-simulation-target="resetBtn">&#8635;</button>
  </div>
</div>
