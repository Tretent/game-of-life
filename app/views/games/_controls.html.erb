<div class="game-controls" data-controller="simulation"
     data-simulation-max-generation-value="1000"
     data-simulation-next-form-id-value="<%= dom_id(game, :next_generation_form) %>"
     data-simulation-reset-form-id-value="<%= dom_id(game, :reset_form) %>">

  <%= form_with url: next_generation_game_path(game),
                method: :post,
                id: dom_id(game, :next_generation_form),
                style: "display: none",
                data: { turbo: true } do %>
  <% end %>
  <%= form_with url: reset_game_path(game),
                method: :post,
                id: dom_id(game, :reset_form),
                style: "display: none",
                data: { turbo: true } do %>
  <% end %>

  <div class="control-group">
    <button type="button" class="control-btn" title="<%= t("games.controls.play") %>"
            data-action="click->simulation#play"
            data-simulation-target="playBtn">&#9205;
    </button>
    <button type="button" class="control-btn" title="<%= t("games.controls.pause") %>"
            data-action="click->simulation#pause"
            data-simulation-target="pauseBtn" disabled>&#9208;
    </button>
    <button type="button" class="control-btn" title="<%= t("games.controls.next") %>"
            data-action="click->simulation#next"
            data-simulation-target="nextBtn">&#9197;
    </button>
  </div>
  <div class="control-group">
    <button type="button" class="control-btn" title="<%= t("games.controls.reset") %>"
            data-action="click->simulation#reset"
            data-simulation-target="resetBtn">&#9198;
    </button>
  </div>
</div>
