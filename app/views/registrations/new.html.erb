<div class="auth-container">
  <h1><%= t(".title") %></h1>

  <% if @user.errors.any? %>
    <div class="error">
      <ul>
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @user, url: registration_path do |form| %>
    <div>
      <%= form.label :email_address, t(".email") %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "email", placeholder: t(".email_placeholder") %>
    </div>
    <div>
      <%= form.label :password, t(".password") %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: t(".password_placeholder"), maxlength: 72 %>
    </div>
    <div>
      <%= form.label :password_confirmation, t(".password_confirmation") %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: t(".password_confirmation_placeholder"), maxlength: 72 %>
    </div>
    <%= form.submit t(".submit") %>
  <% end %>

  <div class="auth-links">
    <p><%= t(".have_account") %> <%= link_to t(".sign_in"), new_session_path %></p>
  </div>
</div>
