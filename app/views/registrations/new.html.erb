<div class="auth-container">
  <h1>Sign up</h1>

  <% if @user.errors.any? %>
    <div class="error">
      <ul>
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @user, url: registration_path do |form| %>
    <div>
      <%= form.label :email_address, "Email" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "email", placeholder: "Enter your email address" %>
    </div>
    <div>
      <%= form.label :password %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: "Enter your password", maxlength: 72 %>
    </div>
    <div>
      <%= form.label :password_confirmation, "Confirm password" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "Confirm your password", maxlength: 72 %>
    </div>
    <%= form.submit "Sign up" %>
  <% end %>

  <div class="auth-links">
    <p>Already have an account? <%= link_to "Sign in", new_session_path %></p>
  </div>
</div>